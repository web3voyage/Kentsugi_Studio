{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kentsugi.local/schema/object-spec.schema.json",
  "title": "Kentsugi ObjectSpec",
  "description": "Semantic object intent emitted by an AI planner. It deliberately contains no paths, code, meshes, or coordinates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["object_spec_version", "name", "category", "family", "variant", "attributes", "requirements"],
  "properties": {
    "object_spec_version": { "const": "0.1.0" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "category": { "enum": ["character", "product", "prop", "vehicle"] },
    "family": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$" },
    "variant": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$" },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colors", "style_tags"],
      "properties": {
        "colors": {
          "type": "array", "maxItems": 6,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_ -]{0,31}$" }
        },
        "style_tags": {
          "type": "array", "maxItems": 12,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_ -]{0,47}$" }
        },
        "finish": { "type": "string", "pattern": "^[a-z][a-z0-9_ -]{0,47}$" },
        "brand_reference": { "type": "string", "maxLength": 80 }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["animation_ready", "texture_required"],
      "properties": {
        "animation_ready": { "type": "boolean" },
        "texture_required": { "type": "boolean" },
        "exact_brand": { "type": "boolean" }
      }
    }
  }
}


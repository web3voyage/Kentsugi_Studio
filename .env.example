# `auto` prefers the Responses provider, then Anthropic, then the demo planner.
KENTSUGI_PLANNER=auto

# AgentRouter's OpenAI Responses-compatible provider.
AGENTROUTER_API_KEY=replace-with-a-fresh-local-token
AGENTROUTER_RESPONSES_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_RESPONSES_MODEL=gpt-5.6-sol
AGENTROUTER_REASONING_EFFORT=medium

# AgentRouter's Anthropic Messages-compatible provider.
ANTHROPIC_AUTH_TOKEN=replace-with-a-fresh-local-token
ANTHROPIC_BASE_URL=https://co.agentrouter.org
ANTHROPIC_MODEL=claude-opus-4-8

